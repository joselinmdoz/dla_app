# Dockerfile para desarrollo local con hot reload
FROM node:20-alpine

# Instalar dependencias necesarias para Prisma
RUN apk add --no-cache openssl openssl-dev

WORKDIR /app

# Copiar primero package.json para instalar dependencias
COPY package*.json ./
COPY prisma ./prisma/

# Instalar dependencias
RUN npm install

# Copiar el resto del código
COPY . .

# Generar cliente Prisma
RUN npx prisma generate

# Exponer puerto
EXPOSE 3000

# Comando para desarrollo con hot reload
CMD ["npm", "run", "dev", "--", "-p", "3000", "--turbo"]
