generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuario para autenticación
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  permissions Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

// Envío / Pedido
model Shipment {
  id            String        @id @default(cuid())
  hbl           String        @unique // Número de guía HBL
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address       String
  city          String?
  
  // Relaciones con catálogos
  shippingTypeId String?
  shippingType   ShippingType? @relation(fields: [shippingTypeId], references: [id])
  
  cargoTypeId   String?
  cargoType     CargoCatalog? @relation(fields: [cargoTypeId], references: [id])
  
  provinceId    String?
  province      Province?     @relation(fields: [provinceId], references: [id])
  
  paymentMethodId String?
  paymentMethod PaymentCatalog? @relation(fields: [paymentMethodId], references: [id])
  
  // Campos legacy para compatibilidad (opcional)
  type          ShipmentType? @default(MARITIMO)
  provinceText  String? // Antiguo campo de provincia como texto
  
  status        ShipmentStatus @default(PENDING)
  price         Decimal       @db.Decimal(10, 2)
  customsTax    Decimal?      @db.Decimal(10, 2) // Impuesto de aduanas
  weight        Decimal?      @db.Decimal(10, 2) // Peso en libras
  freeWeight    Decimal?      @db.Decimal(10, 2) // Peso gratis
  discountAmount Decimal?     @db.Decimal(10, 2) // Descuento
  collectedAmount Decimal?    @db.Decimal(10, 2) // Total cobrado
  offerCode     String?       // Código de oferta
  memo          String?       // Notas adicionales
  trackingUrl   String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt()
  
  products      ShipmentProduct[]
}

enum ShipmentType {
  MARITIMO
  AEREO
  TERRESTRE
}

enum CargoType {
  MISCELANEA
  DURADERO
}

enum PaymentMethod {
  CASH
  ZELLE
  TARJETAS
  TRANSFERENCIA
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Tipo de envío (Marítimo, Aéreo, Terrestre)
model ShippingType {
  id          String    @id @default(cuid())
  name        String    // ej: "Marítimo", "Aéreo"
  code        String    @unique // ej: "MARITIMO", "AEREO"
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  shipments   Shipment[]
}

// Catálogo de tipos de mercancía
model CargoCatalog {
  id          String    @id @default(cuid())
  name        String    // ej: "Miscelánea", "Duradero"
  code        String    @unique // ej: "MISCELANEA", "DURADERO"
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  shipments   Shipment[]
}

// Provincia de destino (Cuba)
model Province {
  id          String    @id @default(cuid())
  name        String    @unique // ej: "Habana", "Santiago de Cuba"
  code        String?   // Código opcional
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  shipments   Shipment[]
  clients     Client[]
}

// Catálogo de métodos de pago
model PaymentCatalog {
  id          String    @id @default(cuid())
  name        String    // ej: "Cash", "Zelle", "Tarjetas"
  code        String    @unique // ej: "CASH", "ZELLE", "TARJETAS"
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  shipments   Shipment[]
}

model Client {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  address     String?
  city        String?
  notes       String?
  
  // Relación con provincia
  provinceId  String?
  province    Province?  @relation(fields: [provinceId], references: [id])
  
  // Campo legacy para compatibilidad
  provinceText String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  shipments   Shipment[]
}

// Categoría de productos (Cajas Super Express, Electrónicos, Motos)
model Category {
  id          String    @id @default(cuid())
  name        String    // ej: "Cajas Super Express"
  slug        String    @unique // ej: "cajas-super-express"
  description String?
  icon        String?   // Nombre del ícono a usar
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  products    Product[]
}

// Producto individual
model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  price       Decimal   @db.Decimal(10, 2) // Precio de venta
  costPrice   Decimal?  @db.Decimal(10, 2) // Precio de costo
  image       String?
  spiceLevel  Int       @default(0) // Nivel de picante
  available   Boolean   @default(true)
  sortOrder   Int       @default(0)
  content     Json?     // Contenido de la caja como array de {item, quantity}
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  shipments   ShipmentProduct[]
  
  @@index([categoryId])
}

// Tabla de relación Shipment-Product (muchos a muchos)
model ShipmentProduct {
  id          String    @id @default(cuid())
  shipmentId  String
  productId   String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2) // Precio al momento del envío
  
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  
  @@index([shipmentId])
  @@index([productId])
}

// Slides del carrusel del Hero
model HeroSlide {
  id          String    @id @default(cuid())
  imageUrl    String    // URL de la imagen
  altText     String    // Texto alternativo para accesibilidad
  title       String?   // Título opcional
  linkUrl     String?   // URL de destino si es clickeable
  sortOrder   Int       @default(0) // Orden de aparición
  isActive    Boolean   @default(true) // Si está activo o no
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
}

// Tarjetas de características/información
model FeatureCard {
  id          String    @id @default(cuid())
  imageUrl    String    // URL de la imagen principal
  altText     String    // Texto alternativo para accesibilidad
  title       String?   // Título de la tarjeta
  description String?   // Descripción/opción de la tarjeta
  linkUrl     String?   // URL de destino si es clickeable
  sortOrder   Int       @default(0) // Orden de aparición
  isActive    Boolean   @default(true) // Si está activo o no
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
}

// Configuración general del sitio
model SiteSettings {
  id                    String   @id @default(cuid())
  key                   String   @unique // Clave de configuración
  value                 String   // Valor de la configuración
  updatedAt             DateTime @updatedAt()
}
